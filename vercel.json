{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true,
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ]
    },
    {
      "src": "/menu/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/",
      "headers": {
        "Location": "https://kurda.com/"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "www.kurda.com"
        }
      ]
    },
    {
      "src": "/index\\.html",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/index\\.php",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "menu.kurda.com"
        }
      ],
      "dest": "/menu/index.html"
    },
    {
      "src": "/robots\\.txt",
      "has": [
        {
          "type": "host",
          "value": "menu.kurda.com"
        }
      ],
      "dest": "/menu/robots.txt"
    },
    {
      "src": "/sitemap\\.xml",
      "has": [
        {
          "type": "host",
          "value": "menu.kurda.com"
        }
      ],
      "dest": "/menu/sitemap.xml"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
